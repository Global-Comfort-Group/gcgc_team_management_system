# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.
.env
.env.production
.env.staging
# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local
.env

# Deployment environment files with credentials
deployment/.env.staging
deployment/.env.production

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# prisma
# NOTE: migrations are intentionally NOT ignored. They were, and every new one
# then needed `git add -f` or it silently never reached the server —
# `prisma migrate deploy` found nothing, the table was never created, and the
# new endpoints 500'd. Tracking them removes that trap entirely.

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
Thumbs.db

# logs
logs
*.log

# temp files
temp/
tmp/

# Security - prevent credential leaks
cookies.txt
*.credentials
*.bundle

# local docs & worktrees
/docs/
/.claude/worktrees/
.playwright-mcp/

# graphify generated output (knowledge graph artifacts + local cache)
/graphify-out/
